@page
@model Gamefilled.Pages.Settings.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    ViewData["ActiveSettings"] = "Notifications";
    ViewData["FullBleed"] = true;
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Stay informed</span>
                <h1>Notifications</h1>
                <p>Notification controls will be introduced with the next expansion of the social feed.</p>
            </div>
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />

            <main class="gf-settings-content">
                <section class="gf-panel">
                    <div class="gf-panel__header">
                        <div>
                            <h2>Notification roadmap</h2>
                            <p>The final controls will only appear once each notification type is supported end to end.</p>
                        </div>
                        <span class="gf-chip"><i class="fas fa-clock" aria-hidden="true"></i> Planned</span>
                    </div>

                    <div class="gf-panel__body gf-settings-tips">
                        <div class="gf-settings-tip"><i class="fas fa-user-plus" aria-hidden="true"></i><span>New followers and mutual connections.</span></div>
                        <div class="gf-settings-tip"><i class="fas fa-star" aria-hidden="true"></i><span>Activity from friends, including ratings and reviews.</span></div>
                        <div class="gf-settings-tip"><i class="fas fa-list" aria-hidden="true"></i><span>List interactions, mentions and future collaborative features.</span></div>
                        <div class="gf-settings-tip"><i class="fas fa-envelope" aria-hidden="true"></i><span>Separate controls for in-app and email delivery.</span></div>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>