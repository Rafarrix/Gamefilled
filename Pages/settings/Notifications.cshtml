@page
@model Gamefilled.Pages.Settings.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    ViewData["ActiveSettings"] = "Notifications";
    ViewData["FullBleed"] = true;
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Notifications</span>
                <h1>Notifications</h1>
                <p>Open your inbox now. Delivery preferences will be added as more interaction types go live.</p>
            </div>
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />
            <main class="gf-settings-content">
                <section class="gf-panel">
                    <div class="gf-panel__header">
                        <div>
                            <h2>Notification inbox</h2>
                            <p>See new followers and mutual connections, then mark updates as read.</p>
                        </div>
                        <span class="gf-chip"><i class="fas fa-circle-check" aria-hidden="true"></i> Live</span>
                    </div>
                    <div class="gf-panel__body">
                        <a class="gf-btn gf-btn--secondary" href="/notifications">
                            <i class="fas fa-bell" aria-hidden="true"></i>
                            Open notifications
                        </a>
                    </div>
                </section>

                <section class="gf-panel" style="margin-top:18px">
                    <div class="gf-panel__header">
                        <div>
                            <h2>Delivery preferences</h2>
                            <p>Per-event controls, email delivery and quiet hours will arrive with the next notification types.</p>
                        </div>
                        <span class="gf-chip"><i class="fas fa-clock" aria-hidden="true"></i> Planned</span>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>
