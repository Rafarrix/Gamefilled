@{
    var active = (ViewData["ActiveSettings"] as string) ?? "Overview";
}

<link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/settings-v2.css" asp-append-version="true" />

<aside class="settings-nav" aria-label="Settings navigation">
    <div class="settings-nav-title">
        <h3>Settings</h3>
        <p>Manage your Gamefilled identity and account preferences.</p>
    </div>

    <nav class="settings-nav-list">
        <div class="settings-nav-group-label">Your profile</div>

        <a class="settings-link @(active == "Overview" ? "active" : string.Empty)" href="/Settings">
            <span class="settings-link__icon"><i class="fas fa-table-cells-large" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Overview</strong>
                <small>Settings and profile shortcuts</small>
            </span>
        </a>

        <a class="settings-link @(active == "Profile" ? "active" : string.Empty)" href="/Settings/Profile">
            <span class="settings-link__icon"><i class="fas fa-user-pen" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Profile</strong>
                <small>Name, bio, avatar and banner</small>
            </span>
        </a>

        <a class="settings-link @(active == "FavoriteGames" ? "active" : string.Empty)" href="/Settings/FavoriteGames">
            <span class="settings-link__icon"><i class="fas fa-crown" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Favorite games</strong>
                <small>Build your featured shelf</small>
            </span>
        </a>

        <div class="settings-nav-group-label">Account</div>

        <a class="settings-link @(active == "Account" ? "active" : string.Empty)" href="/Settings/Account">
            <span class="settings-link__icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Account & security</strong>
                <small>Email, password and sessions</small>
            </span>
            <span class="settings-link__badge">Planned</span>
        </a>

        <a class="settings-link @(active == "Notifications" ? "active" : string.Empty)" href="/Settings/Notifications">
            <span class="settings-link__icon"><i class="fas fa-bell" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Notifications</strong>
                <small>Choose what reaches you</small>
            </span>
            <span class="settings-link__badge">Planned</span>
        </a>

        <a class="settings-link @(active == "Integrations" ? "active" : string.Empty)" href="/Settings/Integrations">
            <span class="settings-link__icon"><i class="fas fa-plug" aria-hidden="true"></i></span>
            <span class="settings-link__copy">
                <strong>Integrations</strong>
                <small>Steam and external services</small>
            </span>
            <span class="settings-link__badge">Planned</span>
        </a>
    </nav>
</aside>
