@page
@model Gamefilled.Pages.Settings.ProfileModel
@{
    ViewData["Title"] = "Edit profile";
    ViewData["ActiveSettings"] = "Profile";

    var avatarPreview = string.IsNullOrWhiteSpace(Model.AvatarUrl)
        ? "/lib/imgs/defaultavatar.png"
        : Model.AvatarUrl;

    var bannerPreview = string.IsNullOrWhiteSpace(Model.BannerUrl)
        ? "/lib/imgs/defaultbanner.jpg"
        : Model.BannerUrl;
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Public identity</span>
                <h1>Edit profile</h1>
                <p>Control how your name, bio, avatar and banner appear across Gamefilled.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CurrentUsername))
            {
                <a class="gf-btn gf-btn--secondary" href="/u/@Model.CurrentUsername">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    View profile
                </a>
            }
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />

            <main class="gf-settings-content">
                <form method="post">
                    <div class="gf-settings-form-grid">
                        <div class="gf-settings-stack">
                            <section class="gf-settings-preview" aria-label="Profile preview">
                                <div class="gf-settings-preview__banner" style="background-image:url('@bannerPreview')"></div>
                                <div class="gf-settings-preview__fade"></div>
                                <img class="gf-settings-preview__avatar" src="@avatarPreview" alt="Current avatar preview" />
                            </section>

                            <section class="gf-panel">
                                <div class="gf-panel__header">
                                    <div>
                                        <h2>Profile information</h2>
                                        <p>Your display name and bio are visible to other players.</p>
                                    </div>
                                </div>

                                <div class="gf-panel__body">
                                    <div class="gf-field">
                                        <label class="gf-label" asp-for="DisplayName">Display name</label>
                                        <input class="gf-input" asp-for="DisplayName" maxlength="100" placeholder="How should people see your name?" />
                                    </div>

                                    <div class="gf-field">
                                        <label class="gf-label" asp-for="Bio">Bio</label>
                                        <textarea class="gf-textarea" asp-for="Bio" rows="6" placeholder="Tell the community what you play and what you enjoy."></textarea>
                                        <span class="gf-help">Maximum 200 words.</span>
                                        <span asp-validation-for="Bio" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="gf-panel">
                                <div class="gf-panel__header">
                                    <div>
                                        <h2>Profile media</h2>
                                        <p>Use direct image URLs while uploads are still being prepared.</p>
                                    </div>
                                </div>

                                <div class="gf-panel__body">
                                    <div class="gf-field">
                                        <label class="gf-label" asp-for="AvatarUrl">Avatar URL</label>
                                        <input class="gf-input" asp-for="AvatarUrl" type="url" placeholder="https://example.com/avatar.jpg" />
                                        <span class="gf-help">Square images work best.</span>
                                    </div>

                                    <div class="gf-field">
                                        <label class="gf-label" asp-for="BannerUrl">Banner URL</label>
                                        <input class="gf-input" asp-for="BannerUrl" type="url" placeholder="https://example.com/banner.jpg" />
                                        <span class="gf-help">Use a wide landscape image for the best result.</span>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <aside class="gf-settings-stack">
                            <section class="gf-panel">
                                <div class="gf-panel__header">
                                    <div>
                                        <h2>Profile tips</h2>
                                        <p>Small details make your profile easier to recognize.</p>
                                    </div>
                                </div>

                                <div class="gf-panel__body gf-settings-tips">
                                    <div class="gf-settings-tip">
                                        <i class="fas fa-image" aria-hidden="true"></i>
                                        <span>Choose an avatar that remains clear at small sizes.</span>
                                    </div>
                                    <div class="gf-settings-tip">
                                        <i class="fas fa-panorama" aria-hidden="true"></i>
                                        <span>Keep important banner details near the center.</span>
                                    </div>
                                    <div class="gf-settings-tip">
                                        <i class="fas fa-align-left" aria-hidden="true"></i>
                                        <span>A short bio works better than a long block of text.</span>
                                    </div>
                                </div>
                            </section>

                            <div class="gf-settings-actions">
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentUsername))
                                {
                                    <a class="gf-btn gf-btn--secondary" href="/u/@Model.CurrentUsername">Cancel</a>
                                }
                                <button type="submit" class="gf-btn gf-btn--primary">
                                    <i class="fas fa-check" aria-hidden="true"></i>
                                    Save profile
                                </button>
                            </div>
                        </aside>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>
