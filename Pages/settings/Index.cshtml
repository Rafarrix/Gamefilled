@page
@model Gamefilled.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["ActiveSettings"] = "Overview";
    ViewData["FullBleed"] = true;
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Your Gamefilled</span>
                <h1>Settings</h1>
                <p>Manage the parts of your profile and account that are already live, while keeping upcoming privacy and integration controls visible.</p>
            </div>
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />

            <main class="gf-settings-content">
                <section class="gf-settings-overview" aria-label="Settings overview">
                    <a class="gf-settings-overview-card" href="/Settings/Profile">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-user-pen" aria-hidden="true"></i></span>
                        <div>
                            <h2>Edit profile</h2>
                            <p>Update your display name, bio, avatar and banner shown across the community.</p>
                        </div>
                        <footer><span>Open profile settings</span><i class="fas fa-arrow-right" aria-hidden="true"></i></footer>
                    </a>

                    <a class="gf-settings-overview-card" href="/Settings/FavoriteGames">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-crown" aria-hidden="true"></i></span>
                        <div>
                            <h2>Favorite games</h2>
                            <p>Curate the shelf that defines your gaming taste and highlight your number one game.</p>
                        </div>
                        <footer><span>Edit featured shelf</span><i class="fas fa-arrow-right" aria-hidden="true"></i></footer>
                    </a>

                    <a class="gf-settings-overview-card" href="/Settings/Account">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
                        <div>
                            <h2>Account & security</h2>
                            <p>Change the email and password used to access your Gamefilled account.</p>
                        </div>
                        <footer><span>Manage credentials</span><i class="fas fa-arrow-right" aria-hidden="true"></i></footer>
                    </a>

                    <a class="gf-settings-overview-card" href="/Settings/Notifications">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-bell" aria-hidden="true"></i></span>
                        <div>
                            <h2>Notifications</h2>
                            <p>Follower, friend, review and list notification controls will be managed here.</p>
                        </div>
                        <footer><span>Planned</span><i class="fas fa-clock" aria-hidden="true"></i></footer>
                    </a>

                    <a class="gf-settings-overview-card" href="/Settings/Integrations">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-plug" aria-hidden="true"></i></span>
                        <div>
                            <h2>Integrations</h2>
                            <p>Steam library sync, playtime and achievements will be connected from this area.</p>
                        </div>
                        <footer><span>Planned</span><i class="fas fa-clock" aria-hidden="true"></i></footer>
                    </a>

                    <div class="gf-settings-overview-card is-planned" aria-label="Privacy and presence controls planned">
                        <span class="gf-settings-overview-card__icon"><i class="fas fa-user-shield" aria-hidden="true"></i></span>
                        <div>
                            <h2>Privacy & presence</h2>
                            <p>Control online status, public activity and profile discoverability during the next social privacy sprint.</p>
                        </div>
                        <footer><span>Next functional setting</span><i class="fas fa-road" aria-hidden="true"></i></footer>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>