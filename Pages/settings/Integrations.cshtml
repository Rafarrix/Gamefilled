@page
@model Gamefilled.Pages.Settings.IntegrationsModel
@{
    ViewData["Title"] = "Integrations";
    ViewData["ActiveSettings"] = "Integrations";
    ViewData["FullBleed"] = true;
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Integrations</span>
                <h1>Integrations</h1>
                <p>Connect external gaming services.</p>
            </div>
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />
            <main class="gf-settings-content">
                <section class="gf-panel">
                    <div class="gf-panel__header">
                        <div><h2>Steam</h2><p>Library, playtime and achievements.</p></div>
                        <span class="gf-chip"><i class="fab fa-steam" aria-hidden="true"></i> Planned</span>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>
