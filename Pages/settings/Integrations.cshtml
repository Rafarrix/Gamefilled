@page
@model Gamefilled.Pages.Settings.IntegrationsModel
@{
    ViewData["Title"] = "Integrations";
    ViewData["ActiveSettings"] = "Integrations";
}

<div class="gf-settings-page">
    <div class="gf-settings-shell">
        <header class="gf-settings-heading">
            <div>
                <span class="gf-eyebrow">Connected gaming</span>
                <h1>Integrations</h1>
                <p>External accounts will enrich the library without replacing your Gamefilled profile.</p>
            </div>
        </header>

        <div class="gf-settings-layout">
            <partial name="~/Pages/Settings/_SettingsNav.cshtml" />

            <main class="gf-settings-content">
                <section class="gf-panel">
                    <div class="gf-panel__header">
                        <div>
                            <h2>Steam integration</h2>
                            <p>The first planned connection will import permitted library and playtime data.</p>
                        </div>
                        <span class="gf-chip"><i class="fab fa-steam" aria-hidden="true"></i> Planned</span>
                    </div>

                    <div class="gf-panel__body gf-settings-tips">
                        <div class="gf-settings-tip">
                            <i class="fas fa-gamepad" aria-hidden="true"></i>
                            <span>Match owned Steam games with their IGDB records.</span>
                        </div>
                        <div class="gf-settings-tip">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            <span>Show authorized playtime and recently played games.</span>
                        </div>
                        <div class="gf-settings-tip">
                            <i class="fas fa-trophy" aria-hidden="true"></i>
                            <span>Prepare achievements and personal statistics for later phases.</span>
                        </div>
                        <div class="gf-settings-tip">
                            <i class="fas fa-user-shield" aria-hidden="true"></i>
                            <span>Respect Steam privacy and provide separate Gamefilled visibility controls.</span>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>
