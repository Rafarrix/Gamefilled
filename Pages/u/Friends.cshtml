@page "/u/{username}/friends"
@model Gamefilled.Pages.u.FriendsModel
@{
    var profileName = Model.ProfileUser.DisplayName ?? Model.ProfileUser.Username ?? "User";
    var profileUsername = Model.ProfileUser.Username ?? string.Empty;

    ViewData["Title"] = $"{profileName} · Friends";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/people.css" asp-append-version="true" />

<div class="gf-people-page">
    <section class="gf-people-hero">
        <div class="gf-people-hero__glow gf-people-hero__glow--one"></div>
        <div class="gf-people-hero__glow gf-people-hero__glow--two"></div>

        <div class="container gf-people-hero__inner">
            <div class="gf-people-hero__copy">
                <div class="gf-people-eyebrow">@(Model.IsOwnProfile ? "Your circle" : "Mutual connections")</div>
                <h1>@(Model.IsOwnProfile ? "Your friends" : $"{profileName}'s friends")</h1>
                <p>@(Model.IsOwnProfile ? "People you follow who follow you back." : "People who follow each other across the Gamefilled community.")</p>
            </div>

            <div class="gf-people-hero__stats" aria-label="Friends overview">
                <div>
                    <strong>@Model.Friends.Count</strong>
                    <span>mutual friends</span>
                </div>
            </div>
        </div>
    </section>

    <main class="container gf-people-shell">
        <div class="gf-people-results-head">
            <div>
                <h2>@(Model.IsOwnProfile ? "People in your circle" : "Friends")</h2>
                <p>@(Model.IsOwnProfile ? "These connections are mutual." : "Mutual follows are treated as friendships.")</p>
            </div>

            <a class="gf-people-clear" href="/u/@profileUsername">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to profile
            </a>
        </div>

        @if (Model.Friends.Any())
        {
            <section class="gf-people-grid" aria-label="Mutual friends">
                @foreach (var friend in Model.Friends)
                {
                    var avatar = string.IsNullOrWhiteSpace(friend.AvatarUrl)
                        ? "/lib/imgs/defaultavatar.png"
                        : friend.AvatarUrl;
                    var displayName = friend.DisplayName ?? friend.Username ?? "User";

                    <article class="gf-person-card">
                        <a class="gf-person-card__identity" href="/u/@friend.Username">
                            <span class="gf-person-card__avatar-wrap">
                                <img class="gf-person-card__avatar"
                                     src="@avatar"
                                     alt="@displayName avatar"
                                     loading="lazy" />
                                <span class="gf-presence-dot @(friend.IsOnlineNow ? "is-online" : string.Empty)"
                                      title="@friend.PresenceText"
                                      aria-label="@friend.PresenceText"></span>
                            </span>

                            <span class="gf-person-card__names">
                                <strong>@displayName</strong>
                                <small>@@@friend.Username</small>
                            </span>
                        </a>

                        <div class="gf-person-card__badges">
                            <span class="gf-social-badge is-mutual">
                                <i class="fas fa-user-group" aria-hidden="true"></i>
                                Mutual
                            </span>
                            <span class="gf-person-card__presence">@friend.PresenceText</span>
                        </div>

                        <div class="gf-person-card__actions">
                            <a class="gf-person-card__profile" href="/u/@friend.Username">View profile</a>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="gf-people-empty">
                <span class="gf-people-empty__icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
                <h2>@(Model.IsOwnProfile ? "No friends yet" : "No mutual friends yet")</h2>
                <p>@(Model.IsOwnProfile ? "Follow players you like. When they follow you back, they will appear here." : "When two people follow each other, they will appear here.")</p>
                <a href="/people">Discover people</a>
            </section>
        }
    </main>
</div>
