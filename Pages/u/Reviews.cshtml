@page "/u/{username}/reviews"
@using Gamefilled.Models
@model Gamefilled.Pages.u.ReviewsModel
@{
    var displayName = Model.Owner.DisplayName ?? Model.Owner.Username ?? "Player";
    var username = Model.Owner.Username ?? string.Empty;
    var avatar = string.IsNullOrWhiteSpace(Model.Owner.AvatarUrl)
        ? "/lib/imgs/defaultavatar.png"
        : Model.Owner.AvatarUrl;

    ViewData["Title"] = $"{displayName} · Reviews";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reviews-v2.css" asp-append-version="true" />

<div class="gf-reviews-page">
    <header class="gf-reviews-hero">
        <div class="gf-reviews-shell gf-reviews-hero__inner">
            <div>
                <span class="gf-eyebrow">@(Model.IsOwnProfile ? "Your voice" : "Player voice")</span>
                <h1>@(Model.IsOwnProfile ? "Your reviews" : $"{displayName}'s reviews")</h1>
                <p>@(Model.IsOwnProfile
                    ? "Your thoughts, ratings and memorable takes in one place."
                    : $"Thoughts and ratings shared by {displayName}.")</p>
            </div>

            <a class="gf-reviews-owner" href="/u/@username">
                <img src="@avatar" alt="@displayName avatar" />
                <span>
                    <small>Back to profile</small>
                    <strong>@displayName</strong>
                </span>
            </a>

            <div class="gf-reviews-summary" aria-label="Review summary">
                <div><strong>@Model.TotalReviews</strong><span>@(Model.TotalReviews == 1 ? "review" : "reviews")</span></div>
                <div><strong>@(Model.AverageRating?.ToString("0.0") ?? "—")</strong><span>average rating</span></div>
            </div>
        </div>
    </header>

    <main class="gf-reviews-shell gf-reviews-main">
        <nav class="gf-reviews-nav" aria-label="Profile navigation">
            <a href="/u/@username">Overview</a>
            <a href="/u/@username/activity">Activity</a>
            <a class="is-active" href="/u/@username/reviews">Reviews</a>
            <a href="/u/@username/friends">Friends</a>
            <a href="/u/@username/games">Library</a>
        </nav>

        <section class="gf-reviews-toolbar" aria-label="Review controls">
            <form method="get" action="/u/@username/reviews" class="gf-reviews-search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search"
                       name="q"
                       value="@Model.Query"
                       placeholder="@(Model.IsOwnProfile ? "Search your reviews" : "Search reviews")"
                       aria-label="@(Model.IsOwnProfile ? "Search your reviews" : "Search reviews")" />
                @if (Model.Sort != "recent")
                {
                    <input type="hidden" name="sort" value="@Model.Sort" />
                }
                <button type="submit">Search</button>
            </form>

            <div class="gf-reviews-sort" aria-label="Sort reviews">
                <span>Sort</span>
                <a class="@(Model.Sort == "recent" ? "is-active" : string.Empty)" href="@Model.SortUrl("recent")">Recent</a>
                <a class="@(Model.Sort == "rating" ? "is-active" : string.Empty)" href="@Model.SortUrl("rating")">Rating</a>
                <a class="@(Model.Sort == "title" ? "is-active" : string.Empty)" href="@Model.SortUrl("title")">Title</a>
            </div>
        </section>

        @if (Model.Reviews.Any())
        {
            <section class="gf-reviews-grid" aria-label="Reviews">
                @foreach (var review in Model.Reviews)
                {
                    <article class="gf-review-card">
                        <a class="gf-review-card__cover" href="/games/@review.GameId" title="@review.GameName">
                            @if (!string.IsNullOrWhiteSpace(review.CoverUrl))
                            {
                                <img src="@review.CoverUrl" alt="@review.GameName" loading="lazy" />
                            }
                            else
                            {
                                <span><i class="fas fa-gamepad" aria-hidden="true"></i></span>
                            }
                        </a>

                        <div class="gf-review-card__content">
                            <div class="gf-review-card__head">
                                <div>
                                    <a href="/games/@review.GameId">@review.GameName</a>
                                    <span>
                                        @if (review.ReleaseYear.HasValue)
                                        {
                                            <text>@review.ReleaseYear · </text>
                                        }
                                        @Model.StatusLabel(review.Status)
                                    </span>
                                </div>

                                @if (review.Rating.HasValue)
                                {
                                    <strong><i class="fas fa-star" aria-hidden="true"></i>@review.Rating/10</strong>
                                }
                            </div>

                            @if (review.ContainsSpoilers)
                            {
                                <details class="gf-review-card__spoiler">
                                    <summary><i class="fas fa-eye-slash" aria-hidden="true"></i> Reveal spoiler review</summary>
                                    <p>@review.ReviewText</p>
                                </details>
                            }
                            else
                            {
                                <p class="gf-review-card__text">@review.ReviewText</p>
                            }

                            <footer>
                                <span>Updated @review.UpdatedAt.ToString("MMM d, yyyy")</span>
                                <a href="/games/@review.GameId">Open game <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                            </footer>
                        </div>
                    </article>
                }
            </section>

            @if (Model.TotalPages > 1)
            {
                <nav class="gf-reviews-pagination" aria-label="Review pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@Model.PageUrl(Model.PageNumber - 1)"><i class="fas fa-arrow-left" aria-hidden="true"></i> Previous</a>
                    }
                    <span>Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="@Model.PageUrl(Model.PageNumber + 1)">Next <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    }
                </nav>
            }
        }
        else
        {
            <section class="gf-empty-state gf-reviews-empty">
                <span class="gf-empty-state__icon"><i class="fas fa-star" aria-hidden="true"></i></span>
                <h2>@(string.IsNullOrWhiteSpace(Model.Query) ? "No reviews yet" : "No matching reviews")</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.Query)
                    ? (Model.IsOwnProfile ? "Write a review from any game page and it will appear here." : "This player has not shared a review yet.")
                    : "Try another game title or a different phrase.")</p>
                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <a class="gf-btn gf-btn--secondary" href="@Model.PageUrl(1)">Clear search</a>
                }
                else if (Model.IsOwnProfile)
                {
                    <a class="gf-btn gf-btn--secondary" href="/games">Browse games</a>
                }
            </section>
        }
    </main>
</div>
