@page "/about"
@{
    ViewData["Title"] = "About Gamefilled";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/static-family-v2.css" asp-append-version="true" />

<div class="gf-static-page">
    <div class="gf-static-shell">
        <header class="gf-static-hero">
            <span class="gf-eyebrow">About Gamefilled</span>
            <h1>Your games, your story.</h1>
            <p>Gamefilled is a personal gaming hub for discovering games, building a library and sharing the moments that shape your taste.</p>
        </header>

        <div class="gf-static-grid">
            <section class="gf-static-card">
                <h2>Discover</h2>
                <p>Explore games through search, filters, companies, release information, media and connected game universes.</p>
            </section>

            <section class="gf-static-card">
                <h2>Track</h2>
                <p>Organise games as Played, Playing, Backlog or Wishlist, then add personal ratings and reviews.</p>
            </section>

            <section class="gf-static-card">
                <h2>Express</h2>
                <p>Build a public profile around favourite games, activity, reviews and the library that represents you.</p>
            </section>

            <section class="gf-static-card">
                <h2>Connect</h2>
                <p>Find other players, follow profiles and turn mutual follows into meaningful gaming connections.</p>
            </section>

            <section class="gf-static-card gf-static-card--wide">
                <h2>Built beyond the original school project</h2>
                <p>Gamefilled began as a final technical project and is now being rebuilt as an independent product with a stronger architecture, a distinct visual identity and a long-term social roadmap.</p>
            </section>
        </div>
    </div>
</div>
