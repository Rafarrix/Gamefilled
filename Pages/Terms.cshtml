@page "/terms"
@{
    ViewData["Title"] = "Terms";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/static-family-v2.css" asp-append-version="true" />

<div class="gf-static-page">
    <div class="gf-static-shell">
        <header class="gf-static-hero">
            <span class="gf-eyebrow">Pre-release terms</span>
            <h1>Use Gamefilled responsibly.</h1>
            <p>These notes describe the current development version and will be replaced by legally reviewed terms before public launch.</p>
        </header>

        <div class="gf-static-grid">
            <section class="gf-static-card">
                <h2>Your account</h2>
                <p>Keep your login details private and use accurate information when creating or maintaining an account.</p>
            </section>

            <section class="gf-static-card">
                <h2>Your content</h2>
                <p>You remain responsible for reviews, profile text and other content you publish through Gamefilled.</p>
            </section>

            <section class="gf-static-card">
                <h2>Respect the community</h2>
                <p>Do not abuse, harass, impersonate or deliberately disrupt other users or the service.</p>
            </section>

            <section class="gf-static-card">
                <h2>Pre-release availability</h2>
                <p>Features and stored test data may change while the product is under active development.</p>
            </section>

            <section class="gf-static-card gf-static-card--wide">
                <h2>Before production</h2>
                <p>Final terms, moderation rules, account recovery, reporting and appeals will be completed and reviewed before Gamefilled accepts public users.</p>
            </section>
        </div>
    </div>
</div>
