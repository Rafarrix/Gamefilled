@page
@model Gamefilled.Pages.SearchModel
@{
    ViewData["Title"] = "Search";
    ViewData["FullBleed"] = true;
    var results = Model.Results ?? new List<Gamefilled.Pages.SearchModel.SearchGame>();
    var term = Model.Query?.Trim() ?? string.Empty;
}

<link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/search-v2.css" asp-append-version="true" />

<div class="gf-search-page">
    <section class="gf-search-hero">
        <div class="gf-search-shell">
            <span class="gf-eyebrow">Game discovery</span>
            <h1>Search games</h1>
            <p>Find titles, editions, expansions and remasters from the IGDB catalog.</p>

            <form method="get" action="/Search" class="gf-search-form">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search"
                       name="query"
                       value="@term"
                       placeholder="Search by game title"
                       minlength="2"
                       autocomplete="off"
                       aria-label="Search games" />
                <button type="submit">Search</button>
            </form>
        </div>
    </section>

    <main class="gf-search-shell gf-search-main">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <section class="gf-search-state">
                <span class="gf-search-state__icon is-error"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span>
                <h2>Search is temporarily unavailable</h2>
                <p>@Model.Error</p>
                <a class="gf-btn gf-btn--secondary" href="/Search?query=@Uri.EscapeDataString(term)">Try again</a>
            </section>
        }
        else if (term.Length < 2)
        {
            <section class="gf-search-state">
                <span class="gf-search-state__icon"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></span>
                <h2>Start with a game title</h2>
                <p>Enter at least two characters to search the catalog.</p>
            </section>
        }
        else if (results.Count == 0)
        {
            <section class="gf-search-state">
                <span class="gf-search-state__icon"><i class="fas fa-ghost" aria-hidden="true"></i></span>
                <h2>No games found</h2>
                <p>Try a shorter title, another spelling or browse the full game library.</p>
                <a class="gf-btn gf-btn--secondary" href="/games">Browse games</a>
            </section>
        }
        else
        {
            var top = results[0];

            <div class="gf-search-results-head">
                <div>
                    <span class="gf-eyebrow">Results</span>
                    <h2>Matches for “@term”</h2>
                </div>
                <strong>@results.Count @(results.Count == 1 ? "result" : "results")</strong>
            </div>

            <a class="gf-search-feature" href="/games/@top.Id">
                <span class="gf-search-feature__cover">
                    @if (!string.IsNullOrWhiteSpace(top.CoverImageId))
                    {
                        <img src="https://images.igdb.com/igdb/image/upload/t_cover_big/@(top.CoverImageId).jpg"
                             alt="@top.Name" loading="eager" />
                    }
                    else
                    {
                        <span><i class="fas fa-gamepad" aria-hidden="true"></i></span>
                    }
                </span>

                <span class="gf-search-feature__body">
                    <small>Top match</small>
                    <span class="gf-search-feature__title">
                        <strong>@top.Name</strong>
                        @if (top.Year.HasValue)
                        {
                            <em>@top.Year</em>
                        }
                    </span>

                    <span class="gf-search-feature__meta">
                        @if (!string.IsNullOrWhiteSpace(top.CategoryLabel))
                        {
                            <span>@top.CategoryLabel</span>
                        }
                        @foreach (var platform in top.Platforms.Take(6))
                        {
                            <span class="gf-platform-pill gf-platform-pill--sm @PlatformClass(platform)"
                                  data-platform="@PlatformLabel(platform)"
                                  title="@PlatformLabel(platform)"
                                  aria-label="@PlatformLabel(platform)">
                                <span class="gf-platform-pill__icon"><i class="@PlatformIcon(platform)" aria-hidden="true"></i></span>
                            </span>
                        }
                    </span>

                    <span class="gf-search-feature__open">Open game <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                </span>
            </a>

            @if (results.Count > 1)
            {
                <section class="gf-search-grid" aria-label="Other search results">
                    @foreach (var game in results.Skip(1))
                    {
                        <a class="gf-search-card" href="/games/@game.Id">
                            <span class="gf-search-card__cover">
                                @if (!string.IsNullOrWhiteSpace(game.CoverImageId))
                                {
                                    <img src="https://images.igdb.com/igdb/image/upload/t_cover_big/@(game.CoverImageId).jpg"
                                         alt="@game.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span><i class="fas fa-gamepad" aria-hidden="true"></i></span>
                                }
                            </span>

                            <span class="gf-search-card__body">
                                <span class="gf-search-card__title">
                                    <strong>@game.Name</strong>
                                    @if (game.Year.HasValue)
                                    {
                                        <em>@game.Year</em>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(game.CategoryLabel))
                                {
                                    <small>@game.CategoryLabel</small>
                                }
                                <span class="gf-search-card__platforms">
                                    @foreach (var platform in game.Platforms.Take(4))
                                    {
                                        <span class="gf-platform-pill gf-platform-pill--sm @PlatformClass(platform)"
                                              data-platform="@PlatformLabel(platform)"
                                              title="@PlatformLabel(platform)"
                                              aria-label="@PlatformLabel(platform)">
                                            <span class="gf-platform-pill__icon"><i class="@PlatformIcon(platform)" aria-hidden="true"></i></span>
                                        </span>
                                    }
                                </span>
                            </span>
                        </a>
                    }
                </section>
            }
        }
    </main>
</div>

@functions {
    static string PlatformClass(string? platformName)
    {
        var p = (platformName ?? "").Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(p)) return "gf-platform-pill--generic";
        if (p.Contains("playstation") || p == "ps5" || p == "ps4" || p == "ps3" || p == "ps2" || p == "ps vita" || p == "psp") return "gf-platform-pill--playstation";
        if (p.Contains("xbox")) return "gf-platform-pill--xbox";
        if (p.Contains("switch")) return "gf-platform-pill--switch";
        if (p.Contains("nintendo") || p.Contains("game boy") || p.Contains("gameboy") || p.Contains("ds") || p.Contains("3ds") || p.Contains("wii")) return "gf-platform-pill--nintendo";
        if (p.Contains("pc") || p.Contains("windows") || p.Contains("dos") || p.Contains("steam")) return "gf-platform-pill--pc";
        if (p.Contains("mac")) return "gf-platform-pill--mac";
        if (p.Contains("linux") || p.Contains("ubuntu")) return "gf-platform-pill--linux";
        if (p.Contains("android")) return "gf-platform-pill--android";
        if (p.Contains("ios") || p.Contains("iphone") || p.Contains("ipad")) return "gf-platform-pill--ios";
        if (p.Contains("mobile")) return "gf-platform-pill--mobile";
        if (p.Contains("browser") || p.Contains("web")) return "gf-platform-pill--browser";
        if (p.Contains("sega") || p.Contains("dreamcast") || p.Contains("mega drive") || p.Contains("genesis") || p.Contains("saturn") || p.Contains("game gear")) return "gf-platform-pill--sega";
        if (p.Contains("atari") || p.Contains("neo geo") || p.Contains("commodore") || p.Contains("amiga")) return "gf-platform-pill--retro";
        if (p.Contains("cloud")) return "gf-platform-pill--cloud";
        return "gf-platform-pill--generic";
    }

    static string PlatformIcon(string? platformName)
    {
        var p = (platformName ?? "").Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(p)) return "fas fa-gamepad";
        if (p.Contains("playstation") || p == "ps5" || p == "ps4" || p == "ps3" || p == "ps2" || p == "ps vita" || p == "psp") return "fab fa-playstation";
        if (p.Contains("xbox")) return "fab fa-xbox";
        if (p.Contains("steam")) return "fab fa-steam";
        if (p.Contains("windows") || p.Contains("pc") || p.Contains("dos")) return "fab fa-windows";
        if (p.Contains("mac") || p.Contains("ios") || p.Contains("iphone") || p.Contains("ipad")) return "fab fa-apple";
        if (p.Contains("android")) return "fab fa-android";
        if (p.Contains("linux") || p.Contains("ubuntu")) return "fab fa-linux";
        if (p.Contains("browser") || p.Contains("web")) return "fas fa-globe";
        if (p.Contains("cloud")) return "fas fa-cloud";
        if (p.Contains("sega") || p.Contains("dreamcast") || p.Contains("mega drive") || p.Contains("genesis") || p.Contains("saturn")) return "fas fa-compact-disc";
        return "fas fa-gamepad";
    }

    static string PlatformLabel(string? platformName)
    {
        var p = (platformName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(p)) return "Unknown";
        return p switch
        {
            "PC (Microsoft Windows)" => "PC",
            "PlayStation 5" => "PS5",
            "PlayStation 4" => "PS4",
            "PlayStation 3" => "PS3",
            "PlayStation 2" => "PS2",
            "PlayStation Vita" => "PS Vita",
            "PlayStation Portable" => "PSP",
            "Nintendo Switch" => "Switch",
            _ => p
        };
    }
}
