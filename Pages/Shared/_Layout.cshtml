@using Microsoft.AspNetCore.Http
@{
    // Dados do utilizador vindos da sessão.
    string? displayName = null;
    string? username = null;

    // Verifica primeiro se a sessão está disponível.
    var sessionFeature = Context.Features.Get<Microsoft.AspNetCore.Http.Features.ISessionFeature>();
    if (sessionFeature?.Session != null)
    {
        displayName = Context.Session.GetString("displayName");
        username = Context.Session.GetString("username");
    }

    // Define se a página atual usa layout fullbleed.
    var isFullBleed = (ViewData["FullBleed"] as bool?) == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Gamefilled</title>
    <link rel="icon" type="image/png" href="~/lib/imgs/favicon.png" />

    <!-- Meta base -->
    <meta name="description" content="Your personal virtual backlog of video game collection">
    <meta itemprop="name" content="Gamefilled">
    <meta itemprop="description" content="Your personal virtual backlog of video game collection">
    <meta itemprop="image" content="~/imgs/Gamefilled_Logo_0removebg.png">

    <!-- Icons + Bootstrap -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- CSS global -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>

<body class="d-flex flex-column min-vh-100 @(isFullBleed ? "fullbleed" : "")">

    <!-- Elemento auxiliar visual -->
    <div class="d-none" id="main-gradient"></div>

    <!-- HEADER -->
    <header class="site-header @(isFullBleed ? "site-header--overlay" : "")">
        <nav class="navbar navbar-expand-md navbar-dark @(isFullBleed ? "navbar--overlay" : "")" id="primary-nav">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand mr-2 my-auto py-1" href="/">
                    <img id="gamefilled-logo1"
                         src="@Url.Content("~/lib/imgs/Gamefilled_Logo_0removebg.png")"
                         alt="Gamefilled"
                         height="50" />
                </a>

                <!-- MOBILE: linha compacta -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item mr-sm-2 d-inline d-md-none">
                        <a class="nav-link d-inline mr-1 position-relative" id="nav-notification-bell" href="/notifications/">
                            <i class="fas fa-bell"></i>
                            <span class="notification-indicator"></span>
                        </a>

                        <a class="nav-link d-inline mr-2" href="/games">Games</a>

                        <button class="navbar-toggler collapsed" type="button"
                                data-toggle="collapse"
                                data-target="#navbarSupportedContent"
                                aria-controls="navbarSupportedContent"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </li>
                </ul>

                <!-- DESKTOP / ÁREA COLAPSÁVEL -->
                <div class="collapse navbar-collapse mt-2 mt-md-0" id="navbarSupportedContent">

                    <ul class="navbar-nav ml-auto align-items-md-center">
                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link position-relative" id="nav-notification-bell" href="/notifications/">
                                <i class="fas fa-bell"></i>
                                <span class="notification-indicator"></span>
                            </a>
                        </li>

                        @* Se não existir sessão de utilizador, mostra login/register *@
                        @if (string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item d-none d-md-block mr-2">
                                <a class="nav-link" href="/users/Register">Register</a>
                            </li>
                            <li class="nav-item d-none d-md-block mr-2">
                                <a class="nav-link" href="/users/Login">Login</a>
                            </li>
                        }
                        else
                        {
                            @* Se existir utilizador autenticado, mostra menu de perfil *@
                            <li class="nav-item dropdown d-none d-md-block" id="profile-li">
                                <div class="d-flex align-items-center" id="profile-compact">
                                    <a class="nav-link pr-1" id="nav-username" href="/u/@(username)/">@displayName</a>

                                    <a class="nav-link dropdown-toggle hide-caret profile-toggle pl-1 pr-1"
                                       id="navbarDropdown"
                                       role="button"
                                       data-toggle="dropdown"
                                       aria-haspopup="true"
                                       aria-expanded="false"
                                       href="#"
                                       title="Menu">
                                        <i class="fas fa-chevron-down fa-xs"></i>
                                    </a>
                                </div>

                                <div class="dropdown-menu mt-0 py-0" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item py-1" href="/u/@(username)/">Profile</a>
                                    <div class="dropdown-divider my-0"></div>

                                    <a class="dropdown-item py-1" href="/u/@(username)/games/">Played</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/playing/">Playing</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/backlog/">Backlog</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/wishlist/">Wishlist</a>

                                    <div class="dropdown-divider my-0"></div>

                                    <a class="dropdown-item py-1" href="/u/@(username)/journal/">Journal</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/activity/">Activity</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/reviews/">Reviews</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/lists/">Lists</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/friends/">Friends</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/likes/">Likes</a>

                                    <div class="dropdown-divider my-0"></div>

                                    <a class="dropdown-item py-1" href="/Settings">Settings</a>

                                    <!-- Logout via POST -->
                                    <form method="post" asp-page="/users/Logout" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item pt-1 pb-2 w-100 text-left">
                                            Log Out
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }

                        <li class="nav-item d-none d-md-block mr-2">
                            <a class="nav-link" href="/games">Games</a>
                        </li>
                    </ul>

                    <!-- SEARCH -->
                    <form class="form-inline mx-3 mx-md-0 my-2 my-md-0"
                          data-turbo="false"
                          action="/search"
                          method="get">

                        <div class="search-wrap position-relative" id="nav-search-wrap">
                            <input class="form-control search-bar"
                                   id="nav-bar-search"
                                   type="search"
                                   placeholder="Search"
                                   aria-label="Search"
                                   name="query"
                                   autocomplete="off" />

                            <button class="search-icon-btn" type="submit" aria-label="Search">
                                <i class="fas fa-search"></i>
                            </button>

                            <!-- Dropdown do autocomplete -->
                            <div class="igdb-dropdown d-none" id="igdb-dropdown" role="listbox" aria-label="Search results"></div>
                        </div>
                    </form>

                </div>
            </div>
        </nav>

        <!-- Barra visual de loading -->
        <div id="header-loader">
            <div class="header-loader-bar"></div>
        </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL -->
    <main role="main" class="@(isFullBleed ? "flex-grow-1 p-0" : "container flex-grow-1 pb-3")">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer mt-auto">
        <div class="container py-2">
            <div class="row mx-0">
                <div class="col px-0">
                    <div class="row mx-0 text-muted">
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/about/">About</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/contact/">Contact</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/terms/">Terms</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/privacy/">Privacy</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>