@using Microsoft.AspNetCore.Http
@{
    // displayName: o que aparece no menu
    string? displayName = null;

    // username: o que vais usar para construir URLs /u/{username}
    string? username = null;

    // Protege o acesso à sessão caso a sessão não esteja configurada nesta requisição
    var sessionFeature = Context.Features.Get<Microsoft.AspNetCore.Http.Features.ISessionFeature>();
    if (sessionFeature?.Session != null)
    {
        // ✅ chaves corretas (iguais às do Login.cshtml.cs)
        displayName = Context.Session.GetString("displayName");
        username = Context.Session.GetString("username");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Gamefilled</title>

    <meta name="description" content="Your personal virtual backlog of video game collection">
    <meta itemprop="name" content="Gamefilled">
    <meta itemprop="description" content="Your personal virtual backlog of video game collection">
    <meta itemprop="image" content="~/imgs/Gamefilled_Logo_0removebg.png">

    <!-- Icons + Bootstrap -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- ✅ Teu CSS (carrega por último para ganhar prioridade) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>

@*
   ✅ Body como flex column (Bootstrap):
   - min-vh-100 garante altura mínima do ecrã
   - d-flex flex-column permite empurrar o footer para baixo
*@
<body class="d-flex flex-column min-vh-100">

    <div class="d-none" id="main-gradient"></div>

    <!-- =========================
         HEADER / NAVBAR
         ========================= -->
    <header>
        <nav class="navbar navbar-expand-md navbar-dark" id="primary-nav">
            <div class="container">
                <!-- LOGO -->
                <a class="navbar-brand mr-2 my-auto py-1" href="/">
                    <img id="gamefilled-logo1"
                         src="@Url.Content("~/lib/imgs/Gamefilled_Logo_0removebg.png")"
                         alt="Gamefilled"
                         height="50" />
                </a>

                <!-- MOBILE (linha compacta à direita) -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item mr-sm-2 d-inline d-md-none">
                        <a class="nav-link d-inline mr-1 position-relative" id="nav-notification-bell" href="/notifications/">
                            <i class="fas fa-bell"></i>
                            <span class="notification-indicator"></span>
                        </a>

                        <a class="nav-link d-inline mr-2" href="/games/lib/popular/">Games</a>

                        <button class="navbar-toggler collapsed" type="button"
                                data-toggle="collapse"
                                data-target="#navbarSupportedContent"
                                aria-controls="navbarSupportedContent"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </li>
                </ul>

                <!-- DESKTOP / COLLAPSE -->
                <div class="collapse navbar-collapse mt-2 mt-md-0" id="navbarSupportedContent">

                    <ul class="navbar-nav ml-auto align-items-md-center">
                        <!-- Notification bell (desktop) -->
                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link position-relative" id="nav-notification-bell" href="/notifications/">
                                <i class="fas fa-bell"></i>
                                <span class="notification-indicator"></span>
                            </a>
                        </li>

                        @* Desktop: se NÃO houver sessão mostra Register/Login *@
                        @if (string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item d-none d-md-block mr-2">
                                <a class="nav-link" href="/users/Register">Register</a>
                            </li>
                            <li class="nav-item d-none d-md-block mr-2">
                                <a class="nav-link" href="/users/Login">Login</a>
                            </li>
                        }
                        else
                        {
                            <!-- =========================
                                 USER (desktop)
                                 - Ajustado para o nome ficar mais perto do chevron
                                 ========================= -->
                            <li class="nav-item dropdown d-none d-md-block" id="profile-li">
                                <div class="d-flex align-items-center" id="profile-compact">
                                    @* Mostra displayName mas usa username para o link *@
                                    <a class="nav-link pr-1" id="nav-username" href="/u/@(username)/">@displayName</a>

                                    <a class="nav-link dropdown-toggle hide-caret profile-toggle pl-1 pr-1"
                                       id="navbarDropdown"
                                       role="button"
                                       data-toggle="dropdown"
                                       aria-haspopup="true"
                                       aria-expanded="false"
                                       href="#"
                                       title="Menu">
                                        <i class="fas fa-chevron-down fa-xs"></i>
                                    </a>

                                </div>

                                <div class="dropdown-menu mt-0 py-0" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item py-1" href="/u/@(username)/">Profile</a>
                                    <div class="dropdown-divider my-0"></div>

                                    <a class="dropdown-item py-1" href="/u/@(username)/games/">Played</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/playing/">Playing</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/backlog/">Backlog</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/wishlist/">Wishlist</a>

                                    <div class="dropdown-divider my-0"></div>

                                    <a class="dropdown-item py-1" href="/u/@(username)/journal/">Journal</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/activity/">Activity</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/reviews/">Reviews</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/lists/">Lists</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/following/">Friends</a>
                                    <a class="dropdown-item py-1" href="/u/@(username)/likes/">Likes</a>

                                    <div class="dropdown-divider my-0"></div>

                                    @* settings *@
                                    <a class="dropdown-item py-1" href="/Settings">Settings</a>

                                    @* logout (troca para o teu logout real) *@
                                    <form method="post" action="/Users/Logout" class="m-0">
                                        <button type="submit" class="dropdown-item pt-1 pb-2">Log Out</button>
                                    </form>

                                </div>
                            </li>
                        }

                        @* Mobile: mostra links apropriados *@
                        @if (string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item mr-sm-2 d-block d-md-none">
                                <a class="nav-link" href="/Account/Login">Login</a>
                            </li>
                            <li class="nav-item mr-sm-2 d-block d-md-none">
                                <a class="nav-link" href="/Account/Register">Register</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mr-sm-2 d-block d-md-none">
                                <div class="row mx-0" id="mobile-user-nav">
                                    <div class="col-4 pr-1">
                                        <a class="nav-link" href="/u/@(username)"><i class="fas fa-user-alt"></i> My Profile</a>
                                    </div>
                                    <div class="col-4 px-1">
                                        <a class="nav-link" href="/Settings"><i class="fas fa-cogs"></i> Settings</a>
                                    </div>
                                    <div class="col-4 pl-1">
                                        <a class="nav-link" href="/users/Logout">
                                            <i class="fas fa-sign-out-alt"></i> Log Out
                                        </a>
                                    </div>
                                </div>
                            </li>
                        }

                        <li class="nav-item d-none d-md-block mr-2">
                            <a class="nav-link" href="/games/lib/popular/">Games</a>
                        </li>
                    </ul>

                    <!-- =========================
                         SEARCH
                         - Lupa dentro do input
                         - Sem input-group-append
                         ========================= -->
                    <form class="form-inline mx-3 mx-md-0 my-2 my-md-0"
                          data-turbo="false"
                          action="/search"
                          accept-charset="UTF-8"
                          method="post">
                        <input type="hidden" name="authenticity_token" value="{{TOKEN_CSRF}}" autocomplete="off" />

                        <!-- wrapper position-relative para colocar a lupa dentro -->
                        <div class="search-wrap position-relative">
                            <input class="form-control search-bar"
                                   id="nav-bar-search"
                                   type="search"
                                   placeholder="Search"
                                   aria-label="Search"
                                   name="query"
                                   autocomplete="off"
                                   data-behavior="autocomplete" />

                            <!-- botão transparente (sem fundo) em cima do input -->
                            <button class="search-icon-btn" type="submit" aria-label="Search">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>


                </div>
            </div>
        </nav>
    </header>

    <!-- =========================
         MAIN
         ========================= -->
    <main role="main" class="container flex-grow-1 pb-3">
        @RenderBody()
    </main>

    <!-- =========================
         FOOTER
         ========================= -->
    <footer class="footer mt-auto">
        <div class="container py-2">
            <div class="row mx-0">
                <div class="col px-0">
                    <div class="row mx-0 text-muted">
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/about/">About</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/contact/">Contact</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/terms/">Terms</a>
                        </div>
                        <div class="col-auto ml-auto ml-md-0 my-auto px-0 mr-2">
                            <a href="/privacy/">Privacy</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts: jQuery + Bootstrap bundle (dropdown precisa disto) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>