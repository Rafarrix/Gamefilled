@page "/games/{id:int}"
@model Gamefilled.Pages.games.GameModel
@{
    ViewData["Title"] = Model.Game?.Name ?? "Game";
    ViewData["FullBleed"] = true;

    var companies = (Model.Game?.InvolvedCompanies ?? new List<Gamefilled.Infrastructure.IgdbInvolvedCompanyDto>())
        .Where(item => item.Company is { Id: > 0 } && !string.IsNullOrWhiteSpace(item.Company.Name))
        .GroupBy(item => item.Company!.Id)
        .Select(group => new
        {
            Company = group.First().Company!,
            Developer = group.Any(item => item.Developer),
            Publisher = group.Any(item => item.Publisher),
            Porting = group.Any(item => item.Porting),
            Supporting = group.Any(item => item.Supporting)
        })
        .OrderByDescending(item => item.Developer)
        .ThenByDescending(item => item.Publisher)
        .ThenBy(item => item.Company.Name)
        .ToList();

    var primaryDeveloper = companies.FirstOrDefault(item => item.Developer)?.Company;
    var trailer = Model.Game?.Videos?
        .FirstOrDefault(video => !string.IsNullOrWhiteSpace(video.VideoId));
    var screenshots = (Model.Game?.Screenshots ?? new List<Gamefilled.Infrastructure.IgdbImageDto>())
        .Where(screenshot => !string.IsNullOrWhiteSpace(screenshot.ImageId))
        .Take(8)
        .ToList();
    var hasMedia = trailer != null || screenshots.Count > 0;
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/game-v2.css" asp-append-version="true" />

<div class="gf-game-page">
    <div class="gf-cover-art" id="game-cover-art">
        <div id="gradient"></div>

        @if (!string.IsNullOrWhiteSpace(Model.BgUrl))
        {
            <img src="@Model.BgUrl" alt="" aria-hidden="true" />
        }
    </div>

    <div class="bl-shell">
        <div class="bl-top">
            <div class="bl-cover">
                @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" alt="@Model.Game?.Name" />
                }
                else
                {
                    <div class="bl-cover-fallback"></div>
                }
            </div>

            <div class="bl-main">
                <div class="bl-title-row">
                    <div class="bl-title-wrap">
                        <h1 class="bl-title">@Model.Game?.Name</h1>

                        @if (primaryDeveloper != null)
                        {
                            <div class="bl-byline">
                                by
                                <a class="gf-game-company-link"
                                   href="/company/@primaryDeveloper.Id/@primaryDeveloper.Slug">
                                    @primaryDeveloper.Name
                                </a>
                            </div>
                        }
                    </div>

                    @if (Model.Game?.FirstReleaseDateUnix != null)
                    {
                        <div class="bl-release">
                            <span class="pill pill-muted">Released</span>
                            <span class="pill">@UnixToDate(Model.Game.FirstReleaseDateUnix.Value)</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Game?.Summary))
                {
                    <p class="bl-summary">@Model.Game.Summary</p>
                }

                <div class="bl-rows">
                    @if (Model.Game?.Genres?.Any() == true)
                    {
                        <div class="bl-row">
                            <div class="bl-row__label">GENRES</div>
                            <div class="bl-row__value">
                                @foreach (var genre in Model.Game.Genres.Take(8))
                                {
                                    if (genre.Id > 0 && !string.IsNullOrWhiteSpace(genre.Name))
                                    {
                                        <a class="bl-chip gf-game-filter-chip"
                                           href="/games/lib/Popular?PageNumber=1&PageSize=30&Dir=desc&GenreId=@genre.Id"
                                           title="Ver jogos de @genre.Name">
                                            @genre.Name
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (Model.Game?.Platforms?.Any() == true)
                    {
                        <div class="bl-row">
                            <div class="bl-row__label">PLATFORMS</div>
                            <div class="bl-row__value">
                                @foreach (var platform in Model.Game.Platforms.Take(12))
                                {
                                    if (platform.Id > 0 && !string.IsNullOrWhiteSpace(platform.Name))
                                    {
                                        <a class="gf-platform-pill gf-game-platform-link @PlatformClass(platform.Name)"
                                           href="/games/lib/Popular?PageNumber=1&PageSize=30&Dir=desc&PlatformId=@platform.Id"
                                           data-platform="@PlatformLabel(platform.Name)"
                                           title="Ver jogos para @PlatformLabel(platform.Name)"
                                           aria-label="Ver jogos para @PlatformLabel(platform.Name)">
                                            <span class="gf-platform-pill__icon">
                                                <i class="@PlatformIcon(platform.Name)" aria-hidden="true"></i>
                                            </span>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (companies.Count > 0)
                    {
                        <div class="bl-row">
                            <div class="bl-row__label">COMPANIES</div>
                            <div class="bl-row__value">
                                @foreach (var item in companies.Take(12))
                                {
                                    <a class="bl-chip gf-game-company-chip"
                                       href="/company/@item.Company.Id/@item.Company.Slug">
                                        <span>@item.Company.Name</span>

                                        @if (item.Developer)
                                        {
                                            <span class="gf-game-company-role">Dev</span>
                                        }

                                        @if (item.Publisher)
                                        {
                                            <span class="gf-game-company-role">Publisher</span>
                                        }

                                        @if (item.Porting)
                                        {
                                            <span class="gf-game-company-role">Port</span>
                                        }

                                        @if (item.Supporting)
                                        {
                                            <span class="gf-game-company-role">Support</span>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="bl-cards bl-cards--3">
                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Avg Rating</div>
                        <div class="bl-card__value">@Fmt(Model.Game?.AggregatedRating ?? Model.Game?.Rating)</div>
                        <div class="bl-card__sub">@Count(Model.Game?.AggregatedRatingCount ?? Model.Game?.RatingCount) votes</div>
                    </div>

                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Follows</div>
                        <div class="bl-card__value">@Count(Model.Game?.Follows)</div>
                        <div class="bl-card__sub">followers</div>
                    </div>

                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Hypes</div>
                        <div class="bl-card__value">@Count(Model.Game?.Hypes)</div>
                        <div class="bl-card__sub">hype</div>
                    </div>
                </div>

                <div class="bl-ttb-panel">
                    <div class="bl-ttb-panel__title">Time to beat</div>

                    <div class="bl-ttb">
                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(Model.TtbNormallySeconds)</div>
                            <div class="bl-ttb__label">average</div>
                        </div>

                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(Model.TtbCompletelySeconds)</div>
                            <div class="bl-ttb__label">to finish</div>
                        </div>

                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(MasterLike(Model.TtbCompletelySeconds))</div>
                            <div class="bl-ttb__label">to master</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Game?.Storyline))
                {
                    <div class="gf-game-storyline">
                        <strong>Storyline</strong><br />
                        @Model.Game.Storyline
                    </div>
                }

                @if (hasMedia)
                {
                    <section class="gf-media-room" data-media-room>
                        <div class="gf-media-room__head">
                            <div>
                                <h2>Media Room</h2>
                                <p>Trailers e screenshots numa galeria navegável.</p>
                            </div>
                        </div>

                        <div class="gf-media-grid">
                            @if (trailer != null)
                            {
                                var trailerTitle = string.IsNullOrWhiteSpace(trailer.Name)
                                    ? $"{Model.Game?.Name} trailer"
                                    : trailer.Name;
                                var trailerEmbedUrl = $"https://www.youtube-nocookie.com/embed/{trailer.VideoId}?autoplay=1&rel=0";
                                var trailerThumbnailUrl = $"https://i.ytimg.com/vi/{trailer.VideoId}/hqdefault.jpg";

                                <button type="button"
                                        class="gf-media-item"
                                        data-media-item
                                        data-media-type="video"
                                        data-media-src="@trailerEmbedUrl"
                                        data-media-title="@trailerTitle"
                                        aria-label="Abrir @trailerTitle">
                                    <img src="@trailerThumbnailUrl"
                                         alt="@trailerTitle"
                                         loading="lazy" />
                                    <span class="gf-media-item__badge">
                                        <i class="fas fa-film" aria-hidden="true"></i>
                                        Trailer
                                    </span>
                                    <span class="gf-media-item__play" aria-hidden="true">
                                        <i class="fas fa-play"></i>
                                    </span>
                                    <span class="gf-media-item__title">@trailerTitle</span>
                                </button>
                            }

                            @for (var index = 0; index < screenshots.Count; index++)
                            {
                                var screenshot = screenshots[index];
                                var thumbnailUrl = $"https://images.igdb.com/igdb/image/upload/t_screenshot_med/{screenshot.ImageId}.jpg";
                                var fullUrl = $"https://images.igdb.com/igdb/image/upload/t_1080p/{screenshot.ImageId}.jpg";
                                var screenshotTitle = $"{Model.Game?.Name} screenshot {index + 1}";

                                <button type="button"
                                        class="gf-media-item"
                                        data-media-item
                                        data-media-type="image"
                                        data-media-src="@fullUrl"
                                        data-media-title="@screenshotTitle"
                                        aria-label="Abrir screenshot @(index + 1)">
                                    <img src="@thumbnailUrl"
                                         alt="@screenshotTitle"
                                         loading="lazy" />
                                    <span class="gf-media-item__badge">
                                        <i class="fas fa-image" aria-hidden="true"></i>
                                        Screenshot
                                    </span>
                                    <span class="gf-media-item__title">Screenshot @(index + 1)</span>
                                </button>
                            }
                        </div>
                    </section>

                    <div class="gf-media-lightbox"
                         data-media-lightbox
                         role="dialog"
                         aria-modal="true"
                         aria-label="Media viewer"
                         aria-hidden="true"
                         hidden>
                        <button type="button"
                                class="gf-media-lightbox__backdrop"
                                data-media-close
                                aria-label="Fechar galeria"></button>

                        <div class="gf-media-lightbox__dialog">
                            <div class="gf-media-lightbox__toolbar">
                                <div class="gf-media-lightbox__meta">
                                    <span class="gf-media-lightbox__title" data-media-title></span>
                                    <span class="gf-media-lightbox__counter" data-media-counter></span>
                                </div>

                                <button type="button"
                                        class="gf-media-lightbox__close"
                                        data-media-close
                                        aria-label="Fechar galeria">
                                    <i class="fas fa-times" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div class="gf-media-lightbox__stage" data-media-stage></div>

                            <button type="button"
                                    class="gf-media-lightbox__nav gf-media-lightbox__nav--previous"
                                    data-media-previous
                                    aria-label="Media anterior">
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </button>

                            <button type="button"
                                    class="gf-media-lightbox__nav gf-media-lightbox__nav--next"
                                    data-media-next
                                    aria-label="Media seguinte">
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/game-media-room.js" asp-append-version="true" defer></script>

@functions {
    static string UnixToDate(long unix)
    {
        try { return DateTimeOffset.FromUnixTimeSeconds(unix).ToString("MMM dd, yyyy"); }
        catch { return string.Empty; }
    }

    static string Fmt(double? value) =>
        value == null ? "—" : Math.Round(value.Value, 1).ToString("0.0");

    static string Count(int? value) =>
        value == null ? "—" : value.Value.ToString("N0");

    static string Ttb(int? seconds)
    {
        if (seconds == null || seconds <= 0) return "—";
        var hours = Math.Max(1, Math.Round(seconds.Value / 3600.0));
        return $"{hours}h";
    }

    static int? MasterLike(int? completelySeconds) =>
        completelySeconds == null ? null : (int)(completelySeconds.Value * 2.2);

    static string PlatformClass(string? platformName)
    {
        var platform = (platformName ?? string.Empty).Trim().ToLowerInvariant();

        if (platform.Contains("playstation") || platform.StartsWith("ps")) return "gf-platform-pill--playstation";
        if (platform.Contains("xbox")) return "gf-platform-pill--xbox";
        if (platform.Contains("switch")) return "gf-platform-pill--switch";
        if (platform.Contains("nintendo") || platform.Contains("game boy") || platform.Contains("3ds") || platform.Contains("wii")) return "gf-platform-pill--nintendo";
        if (platform.Contains("pc") || platform.Contains("windows") || platform.Contains("dos") || platform.Contains("steam")) return "gf-platform-pill--pc";
        if (platform.Contains("mac")) return "gf-platform-pill--mac";
        if (platform.Contains("linux") || platform.Contains("ubuntu")) return "gf-platform-pill--linux";
        if (platform.Contains("android")) return "gf-platform-pill--android";
        if (platform.Contains("ios") || platform.Contains("iphone") || platform.Contains("ipad")) return "gf-platform-pill--ios";
        if (platform.Contains("browser") || platform.Contains("web")) return "gf-platform-pill--browser";
        if (platform.Contains("cloud")) return "gf-platform-pill--cloud";
        return "gf-platform-pill--generic";
    }

    static string PlatformIcon(string? platformName)
    {
        var platform = (platformName ?? string.Empty).Trim().ToLowerInvariant();

        if (platform.Contains("playstation") || platform.StartsWith("ps")) return "fab fa-playstation";
        if (platform.Contains("xbox")) return "fab fa-xbox";
        if (platform.Contains("steam")) return "fab fa-steam";
        if (platform.Contains("windows") || platform.Contains("pc") || platform.Contains("dos")) return "fab fa-windows";
        if (platform.Contains("mac") || platform.Contains("ios") || platform.Contains("iphone") || platform.Contains("ipad")) return "fab fa-apple";
        if (platform.Contains("android")) return "fab fa-android";
        if (platform.Contains("linux") || platform.Contains("ubuntu")) return "fab fa-linux";
        if (platform.Contains("browser") || platform.Contains("web")) return "fas fa-globe";
        if (platform.Contains("cloud")) return "fas fa-cloud";
        return "fas fa-gamepad";
    }

    static string PlatformLabel(string? platformName)
    {
        var platform = (platformName ?? string.Empty).Trim();

        return platform switch
        {
            "PC (Microsoft Windows)" => "PC",
            "PlayStation 5" => "PS5",
            "PlayStation 4" => "PS4",
            "PlayStation 3" => "PS3",
            "Nintendo Switch" => "Switch",
            "" => "Unknown",
            _ => platform
        };
    }
}
