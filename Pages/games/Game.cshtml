@page "/games/{id:int}"
@model Gamefilled.Pages.games.GameModel
@{
    // Define o título da página com o nome do jogo, se existir.
    ViewData["Title"] = Model.Game?.Name ?? "Game";

    // Ativa layout fullbleed no _Layout.
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div class="gf-game-page">

    <!-- Background superior estilo Backloggd -->
    <div class="gf-cover-art" id="game-cover-art">
        <div id="gradient"></div>

        @if (!string.IsNullOrWhiteSpace(Model.BgUrl))
        {
            <img src="@Model.BgUrl" alt="" aria-hidden="true" />
        }
    </div>

    <!-- Conteúdo principal -->
    <div class="bl-shell">
        <div class="bl-top">

            <!-- Cover principal -->
            <div class="bl-cover">
                @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" alt="@Model.Game?.Name" />
                }
                else
                {
                    <div class="bl-cover-fallback"></div>
                }
            </div>

            <div class="bl-main">

                <!-- Título, estúdio e data -->
                <div class="bl-title-row">
                    <div class="bl-title-wrap">
                        <h1 class="bl-title">@Model.Game?.Name</h1>

                        @{
                            // Tenta descobrir o primeiro developer principal.
                            var dev = Model.Game?.InvolvedCompanies?
                            .Where(x => x.Developer == true && !string.IsNullOrWhiteSpace(x.Company?.Name))
                            .Select(x => x.Company!.Name!)
                            .Distinct()
                            .FirstOrDefault();
                        }

                        @if (!string.IsNullOrWhiteSpace(dev))
                        {
                            <div class="bl-byline">by <strong>@dev</strong></div>
                        }
                    </div>

                    @if (Model.Game?.FirstReleaseDateUnix != null)
                    {
                        <div class="bl-release">
                            <span class="pill pill-muted">Released</span>
                            <span class="pill">@UnixToDate(Model.Game.FirstReleaseDateUnix.Value)</span>
                        </div>
                    }
                </div>

                <!-- Resumo do jogo -->
                @if (!string.IsNullOrWhiteSpace(Model.Game?.Summary))
                {
                    <p class="bl-summary">@Model.Game.Summary</p>
                }

                <!-- Rows de géneros e plataformas -->
                <div class="bl-rows">
                    <div class="bl-row">
                        <div class="bl-row__label">GENRES</div>
                        <div class="bl-row__value">
                            @foreach (var g in (Model.Game?.Genres ?? new()).Take(8))
                            {
                                if (!string.IsNullOrWhiteSpace(g.Name))
                                {
                                    <span class="bl-chip">@g.Name</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="bl-row">
                        <div class="bl-row__label">PLATFORMS</div>
                        <div class="bl-row__value">
                            @foreach (var p in (Model.Game?.Platforms ?? new()).Take(12))
                            {
                                if (!string.IsNullOrWhiteSpace(p.Name))
                                {
                                    <span class="gf-platform-pill @PlatformClass(p.Name)"
                                          data-platform="@PlatformLabel(p.Name)"
                                          title="@PlatformLabel(p.Name)"
                                          aria-label="@PlatformLabel(p.Name)">
                                        <span class="gf-platform-pill__icon">
                                            <i class="@PlatformIcon(p.Name)" aria-hidden="true"></i>
                                        </span>
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Cards estatísticos -->
                <div class="bl-cards bl-cards--3">
                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Avg Rating</div>
                        <div class="bl-card__value">@Fmt(Model.Game?.AggregatedRating ?? Model.Game?.Rating)</div>
                        <div class="bl-card__sub">@Count(Model.Game?.AggregatedRatingCount ?? Model.Game?.RatingCount) votes</div>
                    </div>

                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Follows</div>
                        <div class="bl-card__value">@Count(Model.Game?.Follows)</div>
                        <div class="bl-card__sub">followers</div>
                    </div>

                    <div class="bl-card bl-card--center">
                        <div class="bl-card__label">Hypes</div>
                        <div class="bl-card__value">@Count(Model.Game?.Hypes)</div>
                        <div class="bl-card__sub">hype</div>
                    </div>
                </div>

                <!-- Painel de time to beat -->
                <div class="bl-ttb-panel">
                    <div class="bl-ttb-panel__title">Time to beat</div>

                    <div class="bl-ttb">
                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(Model.TtbNormallySeconds)</div>
                            <div class="bl-ttb__label">average</div>
                        </div>

                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(Model.TtbCompletelySeconds)</div>
                            <div class="bl-ttb__label">to finish</div>
                        </div>

                        <div class="bl-ttb__item">
                            <div class="bl-ttb__value">@Ttb(MasterLike(Model.TtbCompletelySeconds))</div>
                            <div class="bl-ttb__label">to master</div>
                        </div>
                    </div>
                </div>

                <!-- Screenshots -->
                @if (Model.Game?.Screenshots?.Any() == true)
                {
                    <div class="bl-screens">
                        <div class="bl-section-title">Screenshots</div>

                        <div class="bl-media">
                            @foreach (var s in Model.Game.Screenshots.Take(6))
                            {
                                var url = $"https://images.igdb.com/igdb/image/upload/t_screenshot_med/{s.ImageId}.jpg";
                                <img class="bl-media__img" src="@url" alt="Screenshot" loading="lazy" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    // Converte UNIX timestamp em data legível.
    static string UnixToDate(long unix)
    {
        try { return DateTimeOffset.FromUnixTimeSeconds(unix).ToString("MMM dd, yyyy"); }
        catch { return ""; }
    }

    // Formata rating com 1 casa decimal.
    static string Fmt(double? v) => v == null ? "—" : Math.Round(v.Value, 1).ToString("0.0");

    // Formata contagens com separadores.
    static string Count(int? v) => v == null ? "—" : v.Value.ToString("N0");

    // Converte segundos IGDB em texto de horas.
    static string Ttb(int? seconds)
    {
        if (seconds == null || seconds <= 0) return "—";

        var h = Math.Round(seconds.Value / 3600.0);
        if (h <= 0) h = 1;

        return $"{h}h";
    }

    // Estimativa "to master" derivada do valor completely.
    static int? MasterLike(int? completelySeconds)
        => completelySeconds == null ? null : (int)(completelySeconds.Value * 2.2);

    static string PlatformClass(string? platformName)
    {
        var p = (platformName ?? "").Trim().ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(p))
            return "gf-platform-pill--generic";

        if (p.Contains("playstation") || p == "ps5" || p == "ps4" || p == "ps3" || p == "ps2" || p == "ps vita" || p == "psp")
            return "gf-platform-pill--playstation";

        if (p.Contains("xbox"))
            return "gf-platform-pill--xbox";

        if (p.Contains("switch"))
            return "gf-platform-pill--switch";

        if (p.Contains("nintendo") || p.Contains("game boy") || p.Contains("gameboy") || p.Contains("ds") || p.Contains("3ds") || p.Contains("wii"))
            return "gf-platform-pill--nintendo";

        if (p.Contains("pc") || p.Contains("windows") || p.Contains("dos") || p.Contains("steam"))
            return "gf-platform-pill--pc";

        if (p.Contains("mac"))
            return "gf-platform-pill--mac";

        if (p.Contains("linux") || p.Contains("ubuntu"))
            return "gf-platform-pill--linux";

        if (p.Contains("android"))
            return "gf-platform-pill--android";

        if (p.Contains("ios") || p.Contains("iphone") || p.Contains("ipad"))
            return "gf-platform-pill--ios";

        if (p.Contains("mobile"))
            return "gf-platform-pill--mobile";

        if (p.Contains("browser") || p.Contains("web"))
            return "gf-platform-pill--browser";

        if (p.Contains("sega") || p.Contains("dreamcast") || p.Contains("mega drive") || p.Contains("genesis") || p.Contains("saturn") || p.Contains("game gear"))
            return "gf-platform-pill--sega";

        if (p.Contains("atari") || p.Contains("neo geo") || p.Contains("commodore") || p.Contains("amiga"))
            return "gf-platform-pill--retro";

        if (p.Contains("cloud"))
            return "gf-platform-pill--cloud";

        return "gf-platform-pill--generic";
    }

    static string PlatformIcon(string? platformName)
    {
        var p = (platformName ?? "").Trim().ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(p))
            return "fas fa-gamepad";

        if (p.Contains("playstation") || p == "ps5" || p == "ps4" || p == "ps3" || p == "ps2" || p == "ps vita" || p == "psp")
            return "fab fa-playstation";

        if (p.Contains("xbox"))
            return "fab fa-xbox";

        if (p.Contains("steam"))
            return "fab fa-steam";

        if (p.Contains("windows") || p.Contains("pc") || p.Contains("dos"))
            return "fab fa-windows";

        if (p.Contains("mac") || p.Contains("ios") || p.Contains("iphone") || p.Contains("ipad"))
            return "fab fa-apple";

        if (p.Contains("android"))
            return "fab fa-android";

        if (p.Contains("linux") || p.Contains("ubuntu"))
            return "fab fa-linux";

        if (p.Contains("browser") || p.Contains("web"))
            return "fas fa-globe";

        if (p.Contains("switch") || p.Contains("nintendo"))
            return "fas fa-gamepad";

        if (p.Contains("cloud"))
            return "fas fa-cloud";

        if (p.Contains("sega") || p.Contains("dreamcast") || p.Contains("mega drive") || p.Contains("genesis") || p.Contains("saturn"))
            return "fas fa-compact-disc";

        if (p.Contains("atari") || p.Contains("neo geo") || p.Contains("commodore") || p.Contains("amiga"))
            return "fas fa-joystick";

        return "fas fa-gamepad";
    }

    static string PlatformLabel(string? platformName)
    {
        var p = (platformName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(p)) return "Unknown";

        return p switch
        {
            "PC (Microsoft Windows)" => "PC",
            "Xbox Series X|S" => "Xbox Series X|S",
            "Xbox One" => "Xbox One",
            "Xbox 360" => "Xbox 360",
            "PlayStation 5" => "PS5",
            "PlayStation 4" => "PS4",
            "PlayStation 3" => "PS3",
            "PlayStation 2" => "PS2",
            "PlayStation Vita" => "PS Vita",
            "PlayStation Portable" => "PSP",
            "Nintendo Switch" => "Switch",
            _ => p
        };
    }

}