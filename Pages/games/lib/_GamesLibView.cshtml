@using System.Globalization
@model Gamefilled.Pages.games.lib._GamesLibBase

@{
    var filteredModel = Model as Gamefilled.Pages.games.lib._FilteredGamesLibBase;

    string titleUrl = Url.Page("/games/lib/Title") ?? "/games/lib/title/";
    string trendingUrl = Url.Page("/games/lib/Trending") ?? "/games/lib/trending/";
    string releaseUrl = Url.Page("/games/lib/ReleaseDate") ?? "/games/lib/releasedate/";
    string popularUrl = Url.Page("/games/lib/Popular") ?? "/games/lib/popular/";
    string topUrl = Url.Page("/games/lib/TopRated") ?? "/games/lib/toprated/";
    string avgPlayUrl = Url.Page("/games/lib/AvgPlayTime") ?? "/games/lib/avgplaytime/";
    string avgFinishUrl = Url.Page("/games/lib/AvgFinishTime") ?? "/games/lib/avgfinishtime/";

    string currentPath = Model.HttpContext.Request.Path.Value ?? popularUrl;
    string dir = (Model.Dir ?? "desc").ToLowerInvariant();
    string key = (Model.SortKey ?? "").ToLowerInvariant();

    int activeFilterCount = 0;
    if (filteredModel != null)
    {
        if (!string.IsNullOrWhiteSpace(filteredModel.Search)) activeFilterCount++;
        if (filteredModel.PlatformId.HasValue) activeFilterCount++;
        if (filteredModel.GenreId.HasValue) activeFilterCount++;
        if (filteredModel.ReleaseYear.HasValue) activeFilterCount++;
        if (filteredModel.MinimumRating.HasValue) activeFilterCount++;
        if (!string.IsNullOrWhiteSpace(filteredModel.ReleaseStatus)) activeFilterCount++;
    }

    string BuildLink(string path, int pageNumber, string direction, bool includeFilters = true)
    {
        var parts = new List<string>
        {
            $"pageNumber={pageNumber}",
            $"pageSize={Model.PageSize}",
            $"dir={Uri.EscapeDataString(direction)}"
        };

        if (includeFilters && filteredModel != null)
        {
            void AddValue(string name, string? value)
            {
                if (!string.IsNullOrWhiteSpace(value))
                    parts.Add($"{name}={Uri.EscapeDataString(value)}");
            }

            AddValue("Search", filteredModel.Search);
            AddValue("PlatformId", filteredModel.PlatformId?.ToString(CultureInfo.InvariantCulture));
            AddValue("GenreId", filteredModel.GenreId?.ToString(CultureInfo.InvariantCulture));
            AddValue("ReleaseYear", filteredModel.ReleaseYear?.ToString(CultureInfo.InvariantCulture));
            AddValue("MinimumRating", filteredModel.MinimumRating?.ToString(CultureInfo.InvariantCulture));
            AddValue("ReleaseStatus", filteredModel.ReleaseStatus);
        }

        return $"{path}?{string.Join("&", parts)}";
    }

    string PageLink(int pageNumber) => BuildLink(currentPath, pageNumber, dir);
    string DirLink(string direction) => BuildLink(currentPath, 1, direction);
    string SortLink(string url) => BuildLink(url, 1, dir);
    string ClearFiltersLink() => BuildLink(currentPath, 1, dir, includeFilters: false);
}

<link rel="stylesheet" href="~/css/games-library-v2.css" asp-append-version="true" />

@if (filteredModel != null)
{
    <button type="button"
            class="gf-library-filter-tab"
            data-game-filter-open
            aria-controls="game-filter-drawer"
            aria-expanded="false"
            title="Abrir filtros">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <span class="gf-library-filter-tab__label">Filters</span>
        @if (activeFilterCount > 0)
        {
            <span class="gf-library-filter-tab__count" aria-label="@activeFilterCount filtros ativos">
                @activeFilterCount
            </span>
        }
    </button>

    <div class="gf-filter-drawer-overlay"
         data-game-filter-overlay
         aria-hidden="true"></div>

    <aside id="game-filter-drawer"
           class="gf-filter-drawer"
           data-game-filter-drawer
           role="dialog"
           aria-modal="true"
           aria-labelledby="game-filter-title"
           aria-hidden="true">
        <div class="gf-filter-drawer__header">
            <div>
                <div class="gf-filter-drawer__eyebrow">Game discovery</div>
                <h2 id="game-filter-title" class="gf-filter-drawer__title">Find your next game</h2>
                <p class="gf-filter-drawer__subtitle">
                    Combina pesquisa, plataforma, género, ano e classificação.
                </p>
            </div>

            <button type="button"
                    class="gf-filter-drawer__close"
                    data-game-filter-close
                    aria-label="Fechar filtros">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <form method="get" action="@currentPath" class="gf-filter-drawer__body">
            <input type="hidden" name="PageNumber" value="1" />
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <input type="hidden" name="Dir" value="@dir" />

            <div class="form-group">
                <label for="games-filter-search">Pesquisar jogo</label>
                <input id="games-filter-search"
                       class="form-control"
                       type="search"
                       name="Search"
                       value="@filteredModel.Search"
                       placeholder="Ex.: Cyberpunk 2077"
                       autocomplete="off" />
            </div>

            <div class="form-group">
                <label for="games-filter-platform">Plataforma</label>
                <select id="games-filter-platform" class="form-control" name="PlatformId">
                    <option value="">Todas as plataformas</option>
                    @foreach (var platform in filteredModel.Platforms)
                    {
                        if (filteredModel.PlatformId == platform.Id)
                        {
                            <option value="@platform.Id" selected>@platform.Name</option>
                        }
                        else
                        {
                            <option value="@platform.Id">@platform.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="games-filter-genre">Género</label>
                <select id="games-filter-genre" class="form-control" name="GenreId">
                    <option value="">Todos os géneros</option>
                    @foreach (var genre in filteredModel.Genres)
                    {
                        if (filteredModel.GenreId == genre.Id)
                        {
                            <option value="@genre.Id" selected>@genre.Name</option>
                        }
                        else
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="gf-filter-drawer__split">
                <div class="form-group">
                    <label for="games-filter-year">Ano</label>
                    <input id="games-filter-year"
                           class="form-control"
                           type="number"
                           name="ReleaseYear"
                           value="@filteredModel.ReleaseYear"
                           min="1950"
                           max="2200"
                           placeholder="2026" />
                </div>

                <div class="form-group">
                    <label for="games-filter-rating">Rating mínimo</label>
                    <input id="games-filter-rating"
                           class="form-control"
                           type="number"
                           name="MinimumRating"
                           value="@(filteredModel.MinimumRating?.ToString(CultureInfo.InvariantCulture))"
                           min="0"
                           max="100"
                           step="5"
                           placeholder="75" />
                </div>
            </div>

            <div class="form-group">
                <label for="games-filter-release">Estado de lançamento</label>
                <select id="games-filter-release" class="form-control" name="ReleaseStatus">
                    @if (string.IsNullOrWhiteSpace(filteredModel.ReleaseStatus))
                    {
                        <option value="" selected>Todos</option>
                    }
                    else
                    {
                        <option value="">Todos</option>
                    }

                    @if (filteredModel.ReleaseStatus == "released")
                    {
                        <option value="released" selected>Já lançados</option>
                    }
                    else
                    {
                        <option value="released">Já lançados</option>
                    }

                    @if (filteredModel.ReleaseStatus == "upcoming")
                    {
                        <option value="upcoming" selected>Próximos lançamentos</option>
                    }
                    else
                    {
                        <option value="upcoming">Próximos lançamentos</option>
                    }
                </select>
            </div>

            <div class="gf-filter-drawer__footer">
                <button class="btn btn-main gf-filter-drawer__apply" type="submit">
                    <i class="fas fa-sliders-h mr-2" aria-hidden="true"></i>
                    Aplicar filtros
                </button>

                @if (filteredModel.HasActiveFilters)
                {
                    <a class="btn btn-outline-light gf-filter-drawer__clear"
                       href="@ClearFiltersLink()"
                       title="Limpar filtros"
                       aria-label="Limpar filtros">
                        <i class="fas fa-undo" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </form>
    </aside>
}

<div class="games-page">
    <div class="games-topbar mb-3">
        <div class="games-count">
            @(Model.TotalCount > 0 ? Model.TotalCount.ToString("N0") : "0") Games

            @if (activeFilterCount > 0)
            {
                <span class="gf-library-active-filter-note">
                    <i class="fas fa-filter" aria-hidden="true"></i>
                    @activeFilterCount active
                </span>
            }
        </div>

        <div class="games-sortbar">
            <span class="games-sortbar-label">Sort by</span>

            <a class="games-sortbar-arrow" href="@DirLink("asc")" title="Ascendente" aria-label="Ascendente">
                <i class="fas fa-chevron-up"></i>
            </a>

            <a class="games-sortbar-arrow" href="@DirLink("desc")" title="Descendente" aria-label="Descendente">
                <i class="fas fa-chevron-down"></i>
            </a>

            <div class="dropdown games-sortbar-dd">
                <a class="games-sortbar-selected dropdown-toggle"
                   href="#"
                   id="gamesSortDropdown"
                   data-toggle="dropdown"
                   aria-haspopup="true"
                   aria-expanded="false">
                    @Model.PageTitle
                </a>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="gamesSortDropdown">
                    <a class="dropdown-item" href="@SortLink(titleUrl)">Game Title</a>
                    <a class="dropdown-item" href="@SortLink(trendingUrl)">Trending</a>
                    <a class="dropdown-item" href="@SortLink(releaseUrl)">Release Date</a>
                    <a class="dropdown-item" href="@SortLink(popularUrl)">Popularity</a>
                    <a class="dropdown-item" href="@SortLink(topUrl)">Top Rated</a>
                    <a class="dropdown-item" href="@(BuildLink(avgPlayUrl, 1, dir, includeFilters: false))">Avg. Play Time</a>
                    <a class="dropdown-item" href="@(BuildLink(avgFinishUrl, 1, dir, includeFilters: false))">Avg. Finish Time</a>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(filteredModel?.LoadError))
    {
        <div class="alert alert-warning" role="alert">
            @filteredModel.LoadError
        </div>
    }

    @if (Model.Games == null || Model.Games.Count == 0)
    {
        <div class="text-muted">
            Nenhum resultado encontrado com os filtros selecionados.
        </div>
    }
    else
    {
        <div class="games-grid">
            @foreach (var game in Model.Games)
            {
                <a class="game-card"
                   href="/games/@game.Id"
                   title="@game.Name"
                   data-title="@game.Name">
                    <div class="game-cover">
                        @if (!string.IsNullOrWhiteSpace(game.CoverUrl))
                        {
                            <img src="@game.CoverUrl" alt="@game.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="game-cover-fallback"></div>
                        }
                    </div>

                    @if (key == "release-date")
                    {
                        <div class="game-meta">
                            @(game.ReleaseDateText ?? (game.Year?.ToString() ?? ""))
                        </div>
                    }
                    else if (key == "top-rated")
                    {
                        <div class="game-meta">
                            @(game.RatingText ?? "")
                        </div>
                    }
                    else if (key == "avg-play")
                    {
                        <div class="game-meta">
                            @(game.AvgPlayHoursText ?? "")
                        </div>
                    }
                    else if (key == "avg-finish")
                    {
                        <div class="game-meta">
                            @(game.AvgFinishHoursText ?? "")
                        </div>
                    }
                </a>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="games-pagination mt-4" aria-label="Paginação de jogos">
                @{
                    int current = Model.PageNumber;
                    int total = Model.TotalPages;
                    int start = Math.Max(1, current - 2);
                    int end = Math.Min(total, current + 2);

                    while (end - start < 4 && start > 1) start--;
                    while (end - start < 4 && end < total) end++;
                }

                @if (start > 1)
                {
                    <a class="pg" href="@PageLink(1)">1</a>

                    @if (start > 2)
                    {
                        <span class="pg dots">…</span>
                    }
                }

                @for (int p = start; p <= end; p++)
                {
                    <a class="pg @(p == current ? "active" : "")" href="@PageLink(p)">@p</a>
                }

                @if (end < total)
                {
                    @if (end < total - 1)
                    {
                        <span class="pg dots">…</span>
                    }

                    <a class="pg" href="@PageLink(total)">@total</a>
                }
            </nav>
        }
    }
</div>

<script src="~/js/games-library-v2.js" asp-append-version="true" defer></script>
