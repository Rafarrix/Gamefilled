@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/static-family-v2.css" asp-append-version="true" />

<div class="gf-static-page">
    <div class="gf-static-shell">
        <section class="gf-system-state">
            <div class="gf-system-state__icon" aria-hidden="true">
                <i class="@(Model.StatusCode == 404 ? "fas fa-compass" : Model.StatusCode == 403 ? "fas fa-lock" : "fas fa-triangle-exclamation")"></i>
            </div>
            <span class="gf-eyebrow">@(Model.StatusCode == 404 ? "Lost route" : "Gamefilled system")</span>
            <h1>@Model.Heading</h1>
            <p>@Model.Message</p>

            <div class="gf-system-state__actions">
                <a class="gf-btn gf-btn--primary" href="/games">Explore games</a>
                <a class="gf-btn gf-btn--secondary" href="/">Go home</a>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="gf-system-request">Request reference: <code>@Model.RequestId</code></div>
            }
        </section>
    </div>
</div>
