@page "/u/{username}/following"
@model Gamefilled.Pages.users.FollowingModel
@{
    var profileName = Model.ProfileUser.DisplayName ?? Model.ProfileUser.Username ?? "User";
    var profileUsername = Model.ProfileUser.Username ?? string.Empty;

    ViewData["Title"] = $"{profileName} · Following";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/people.css" asp-append-version="true" />

<div class="gf-people-page">
    <section class="gf-people-hero">
        <div class="gf-people-hero__glow gf-people-hero__glow--one"></div>
        <div class="gf-people-hero__glow gf-people-hero__glow--two"></div>

        <div class="container gf-people-hero__inner">
            <div class="gf-people-hero__copy">
                <div class="gf-people-eyebrow">Community</div>
                <h1>@profileName is following</h1>
                <p>Players this profile follows across Gamefilled.</p>
            </div>

            <div class="gf-people-hero__stats" aria-label="Following overview">
                <div>
                    <strong>@Model.Users.Count</strong>
                    <span>following</span>
                </div>
            </div>
        </div>
    </section>

    <main class="container gf-people-shell">
        <div class="gf-people-results-head">
            <div>
                <h2>Following</h2>
                <p>Online players appear first.</p>
            </div>

            <a class="gf-people-clear" href="/u/@profileUsername">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to profile
            </a>
        </div>

        @if (Model.Users.Any())
        {
            <partial name="~/Pages/Shared/_SocialCards.cshtml" model="Model.Users" />
        }
        else
        {
            <section class="gf-people-empty">
                <span class="gf-people-empty__icon"><i class="fas fa-user-plus" aria-hidden="true"></i></span>
                <h2>Not following anyone yet</h2>
                <p>Discover players and follow the profiles that match your taste.</p>
                <a href="/people">Discover people</a>
            </section>
        }
    </main>
</div>
