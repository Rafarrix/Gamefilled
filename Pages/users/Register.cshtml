@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
    ViewData["FullBleed"] = true;
}

<div class="gf-auth-page">
    <div class="gf-auth-bg" aria-hidden="true">
        <img src="/lib/imgs/indexbackground.png" alt="" />
        <div class="gf-auth-bg__overlay"></div>
    </div>

    <div class="gf-auth-shell">
        <div class="gf-auth-card">
            <section class="gf-auth-left" aria-labelledby="register-welcome">
                <div class="gf-auth-brandmark" aria-hidden="true">
                    <img src="/lib/imgs/Gamefilled_Logo_0removebg.png" alt="" />
                </div>

                <div class="gf-auth-brand">
                    <span class="gf-auth-brand__dot"></span>
                    <span>Gamefilled</span>
                </div>

                <h1 class="gf-auth-title" id="register-welcome">Create your account</h1>
                <p class="gf-auth-subtitle">Track games, build your profile and join the community.</p>

                <div class="gf-auth-side-link">
                    Already have an account?
                    <a asp-page="/users/Login">Sign in</a>
                </div>
            </section>

            <section class="gf-auth-right" aria-labelledby="register-form-title">
                <div class="gf-auth-form-wrap">
                    <div class="gf-auth-form-head">
                        <h2 class="gf-auth-form-title" id="register-form-title">Create account</h2>
                        <p class="gf-auth-form-subtitle">Join Gamefilled.</p>
                    </div>

                    @if (Model.Error != null)
                    {
                        <div class="gf-auth-alert" role="alert">@Model.Error</div>
                    }

                    <form method="post" novalidate>
                        <div class="gf-auth-field">
                            <label asp-for="Username" class="gf-auth-label">Username</label>
                            <input asp-for="Username" class="gf-auth-input" placeholder="Username" autocomplete="username" autofocus />
                        </div>

                        <div class="gf-auth-field">
                            <label asp-for="Email" class="gf-auth-label">Email</label>
                            <input asp-for="Email" class="gf-auth-input" type="email" placeholder="Email" autocomplete="email" />
                        </div>

                        <div class="gf-auth-field">
                            <label asp-for="Password" class="gf-auth-label">Password</label>
                            <input asp-for="Password" class="gf-auth-input" type="password" placeholder="Password" autocomplete="new-password" />
                        </div>

                        <div class="gf-auth-field">
                            <label asp-for="ConfirmPassword" class="gf-auth-label">Confirm password</label>
                            <input asp-for="ConfirmPassword" class="gf-auth-input" type="password" placeholder="Confirm password" autocomplete="new-password" />
                        </div>

                        <div class="gf-auth-check">
                            <input type="checkbox" id="terms" required />
                            <label for="terms">
                                I agree to the <a href="/terms">Terms of Service</a> and
                                <a href="/privacy">Privacy Policy</a>.
                            </label>
                        </div>

                        <button type="submit" class="gf-auth-submit">Create account</button>

                        <div class="gf-auth-mobile-link">
                            Already have an account?
                            <a asp-page="/users/Login">Sign in</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>
