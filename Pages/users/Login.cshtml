@page
@model Gamefilled.Pages.Users.LoginModel
@{
    ViewData["Title"] = "Log in";
    ViewData["FullBleed"] = true;
}

<div class="gf-auth-page">

    <!-- Background decorativo -->
    <div class="gf-auth-bg" aria-hidden="true">
        <img src="/lib/imgs/indexbackground.png" alt="" />
        <div class="gf-auth-bg__overlay"></div>
    </div>

    <div class="gf-auth-shell">
        <div class="gf-auth-card">

            <!-- Lado esquerdo: branding / marketing -->
            <div class="gf-auth-left">
                <div class="gf-auth-brandmark" aria-hidden="true">
                    <img src="/lib/imgs/Gamefilled_Logo_0removebg.png" alt="" />
                </div>

                <div class="gf-auth-brand">
                    <span class="gf-auth-brand__dot"></span>
                    <span>Gamefilled</span>
                </div>

                <h1 class="gf-auth-title">Welcome back</h1>

                <p class="gf-auth-subtitle">
                    Sign in to continue tracking games, managing your profile
                    and staying connected with the community.
                </p>

                <div class="gf-auth-side-link">
                    Don’t have an account?
                    <a asp-page="/users/Register">Create one</a>
                </div>
            </div>

            <!-- Lado direito: formulário -->
            <div class="gf-auth-right">
                <div class="gf-auth-form-wrap">
                    <div class="gf-auth-form-head">
                        <h2 class="gf-auth-form-title">Log in</h2>
                        <p class="gf-auth-form-subtitle">Access your Gamefilled account.</p>
                    </div>

                    @if (Model.Error != null)
                    {
                        <div class="gf-auth-alert">@Model.Error</div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="gf-auth-field">
                            <label asp-for="EmailOrUsername" class="gf-auth-label">Email or username</label>
                            <input asp-for="EmailOrUsername"
                                   class="gf-auth-input"
                                   placeholder="Email or Username"
                                   autocomplete="username" />
                        </div>

                        <div class="gf-auth-field">
                            <label asp-for="Password" class="gf-auth-label">Password</label>
                            <input asp-for="Password"
                                   class="gf-auth-input"
                                   type="password"
                                   placeholder="Password"
                                   autocomplete="current-password" />
                        </div>

                        <button type="submit" class="gf-auth-submit">Log in</button>

                        <div class="gf-auth-note">
                            Sign in to continue where you left off.
                        </div>

                        <div class="gf-auth-mobile-link">
                            Don’t have an account?
                            <a asp-page="/users/Register">Create one</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>