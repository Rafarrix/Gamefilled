@page
@model Gamefilled.Pages.Users.LoginModel
@{
    ViewData["Title"] = "Log in";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth-v2.css" asp-append-version="true" />

<div class="gf-auth-page">
    <div class="gf-auth-bg" aria-hidden="true">
        <img src="/lib/imgs/indexbackground.png" alt="" />
        <div class="gf-auth-bg__overlay"></div>
    </div>

    <div class="gf-auth-shell">
        <div class="gf-auth-card">
            <section class="gf-auth-left" aria-labelledby="login-welcome">
                <div class="gf-auth-brandmark" aria-hidden="true">
                    <img src="/lib/imgs/Gamefilled_Logo_0removebg.png" alt="" />
                </div>

                <div class="gf-auth-brand">
                    <span class="gf-auth-brand__dot"></span>
                    <span>Gamefilled</span>
                </div>

                <h1 class="gf-auth-title" id="login-welcome">Welcome back.</h1>

                <p class="gf-auth-subtitle">
                    Continue your library, catch up with friends and keep every game journey in one place.
                </p>

                <div class="gf-auth-side-link">
                    New to Gamefilled?
                    <a asp-page="/users/Register">Create an account</a>
                </div>
            </section>

            <section class="gf-auth-right" aria-labelledby="login-form-title">
                <div class="gf-auth-form-wrap">
                    <div class="gf-auth-form-head">
                        <h2 class="gf-auth-form-title" id="login-form-title">Log in</h2>
                        <p class="gf-auth-form-subtitle">Access your Gamefilled account.</p>
                    </div>

                    @if (Model.Error != null)
                    {
                        <div class="gf-auth-alert" role="alert">@Model.Error</div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="gf-auth-field">
                            <label asp-for="EmailOrUsername" class="gf-auth-label">Email or username</label>
                            <input asp-for="EmailOrUsername"
                                   class="gf-auth-input"
                                   placeholder="Enter your email or username"
                                   autocomplete="username"
                                   autofocus />
                        </div>

                        <div class="gf-auth-field">
                            <label asp-for="Password" class="gf-auth-label">Password</label>
                            <input asp-for="Password"
                                   class="gf-auth-input"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                        </div>

                        <button type="submit" class="gf-auth-submit">Log in</button>

                        <div class="gf-auth-note">
                            Your account activity and personal library remain private unless you choose to share them.
                        </div>

                        <div class="gf-auth-mobile-link">
                            New to Gamefilled?
                            <a asp-page="/users/Register">Create an account</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>
