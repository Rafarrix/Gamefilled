@page "/contact"
@{
    ViewData["Title"] = "Contact";
    ViewData["FullBleed"] = true;
}

<link rel="stylesheet" href="~/css/static-family-v2.css" asp-append-version="true" />

<div class="gf-static-page">
    <div class="gf-static-shell">
        <header class="gf-static-hero">
            <span class="gf-eyebrow">Contact</span>
            <h1>Talk to Gamefilled.</h1>
            <p>The product is still in active development. A public support and feedback channel will be added before launch.</p>
        </header>

        <div class="gf-static-grid">
            <section class="gf-static-card">
                <h2>Product feedback</h2>
                <p>Bug reports, usability feedback and feature ideas will be handled through a dedicated feedback flow.</p>
            </section>

            <section class="gf-static-card">
                <h2>Account support</h2>
                <p>Password recovery, account access and data requests will receive their own secure support path before production.</p>
            </section>

            <section class="gf-static-card gf-static-card--wide">
                <h2>For now</h2>
                <p>This page intentionally avoids publishing a personal contact address. The final support channel will be added when Gamefilled is ready for public users.</p>
            </section>
        </div>
    </div>
</div>
