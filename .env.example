# Copy to .env for local containers. Never commit the real .env file.
ASPNETCORE_ENVIRONMENT=Development

# Use a long unique value. SQL Server requires password complexity.
MSSQL_SA_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=Gamefilleddb;User Id=sa;Password=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD;Encrypt=True;TrustServerCertificate=True
IGDB__ClientId=YOUR_TWITCH_CLIENT_ID
IGDB__ClientSecret=YOUR_TWITCH_CLIENT_SECRET
