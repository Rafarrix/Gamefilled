# Copy this file to .env for local containers. Never commit the real .env file.

# The local app uses HTTP so Development keeps cookies usable without local TLS.
ASPNETCORE_ENVIRONMENT=Development
GAMEFILLED_HTTP_PORT=5000

# Port 14333 avoids colliding with a local SQL Server or SQLEXPRESS installation.
MSSQL_HOST_PORT=14333

# Use a long unique value that satisfies SQL Server password complexity.
# Avoid reusing this password anywhere outside local development.
MSSQL_SA_PASSWORD=CHANGE_ME_LocalOnly_2026!

IGDB__ClientId=YOUR_TWITCH_CLIENT_ID
IGDB__ClientSecret=YOUR_TWITCH_CLIENT_SECRET
