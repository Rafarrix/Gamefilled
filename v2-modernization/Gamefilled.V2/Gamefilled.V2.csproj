<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reject high/critical NuGet advisories in the modernized Identity project. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <!-- Override vulnerable transitive 9.x PKCS package with .NET 10 security fix. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Reuse existing post-PAP V2 styling rather than inventing a new UI. -->
  <ItemGroup>
    <Content Include="../../wwwroot/css/design-system.css" Link="wwwroot/css/design-system.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wwwroot/css/library-v2.css" Link="wwwroot/css/library-v2.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wwwroot/css/library-personal.css" Link="wwwroot/css/library-personal.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Compile the same reviewed mail transport as the running V2; no duplicate API code. -->
  <ItemGroup>
    <Compile Include="../../Application/Email/ITransactionalEmailSender.cs" Link="Shared/Email/ITransactionalEmailSender.cs" />
    <Compile Include="../../Infrastructure/ResendEmailSender.cs" Link="Shared/Email/ResendEmailSender.cs" />
    <!-- Reuse exact tested existing IGDB client and catalog query methods.
         Never duplicate or revise search/discovery/special-category criteria. -->
    <Compile Include="../../Infrastructure/IgdbClient.cs" Link="Shared/Igdb/IgdbClient.cs" />
    <Compile Include="../../Infrastructure/IgdbOptions.cs" Link="Shared/Igdb/IgdbOptions.cs" />
    <Compile Include="../../Infrastructure/IgdbTokenProvider.cs" Link="Shared/Igdb/IgdbTokenProvider.cs" />
    <Compile Include="../../Infrastructure/IgdbDtos.cs" Link="Shared/Igdb/IgdbDtos.cs" />
    <Compile Include="../../Infrastructure/IgdbGameDetailsDto.cs" Link="Shared/Igdb/IgdbGameDetailsDto.cs" />
  </ItemGroup>
</Project>
