@page "/account/reset-password"
@model Gamefilled.V2.Pages.Account.ResetPasswordModel
<h1>Reset your Gamefilled password</h1>
@if (Model.Completed)
{
    <p>Your password has been changed. <a href="/account/login">Sign in with your new password</a>.</p>
}
else if (Model.Invalid)
{
    <p>This reset link is invalid or expired. <a href="/account/forgot-password">Request a new link</a>.</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Code" type="hidden" />
        <label asp-for="NewPassword">New password (12–128 characters)</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" />
        <label asp-for="ConfirmPassword">Repeat new password</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <button type="submit">Change password</button>
    </form>
}
