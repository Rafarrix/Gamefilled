@page "/account/forgot-password"
@model Gamefilled.V2.Pages.Account.ForgotPasswordModel
<h1>Forgot your password?</h1>
@if (Model.RequestAccepted)
{
    <p>If there is a confirmed account for that address, we'll send password reset instructions.</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <label asp-for="Email">Account email address</label>
        <input asp-for="Email" type="email" autocomplete="email" maxlength="254" />
        <button type="submit">Send reset instructions</button>
    </form>
}
<p><a href="/account/login">Return to sign in</a></p>
